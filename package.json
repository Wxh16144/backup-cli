{
  "name": "@wuxh/backup-cli",
  "version": "2.3.0",
  "description": "Backup and restore your dotfiles with copy semantics; npm-native, with prune, interactive selection and per-run logs.",
  "homepage": "https://github.com/Wxh16144/backup-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wxh16144/backup-cli.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Wuxh <wxh16144@qq.com>",
  "type": "module",
  "main": "index.js",
  "bin": {
    "backup-cli": "index.js"
  },
  "files": [
    "applications",
    "mackup/src/mackup/applications",
    "index.js",
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "start": "node --import tsx ./dev.ts -d",
    "test": "node --import tsx tests/index.ts",
    "prepublishOnly": "git submodule update --remote && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-glob": "^3.2.12",
    "fs-extra": "^11.1.1",
    "ini": "^4.0.0",
    "kleur": "^4.1.5",
    "mri": "^1.2.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/ini": "^1.3.31",
    "@types/lodash-es": "^4.17.7",
    "@types/node": "^18.11.19",
    "@types/prompts": "^2.4.3",
    "execa": "^8.0.1",
    "fs-fixture": "^2.14.0",
    "manten": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "unbuild": "^1.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
